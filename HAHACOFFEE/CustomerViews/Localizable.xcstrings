    },
    "Vị chua và ngọt dịu đến từ sự kết hợp của cam và đào, cộng hưởng với hương thơm của sả sẽ khiến để lại ấn tượng khó quên như chiếc vòng của sao Thổ." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sour and subtle sweetness from the dynamic duo of orange and peach, combined with the gentle aroma of lemongrass, will leave you with an unforgettable experience—just like seeing Saturn's rings for the first time."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vị chua và ngọt dịu đến từ sự kết hợp của cam và đào, cộng hưởng với hương thơm của sả sẽ khiến để lại ấn tượng khó quên như chiếc vòng của sao Thổ."
          }
        }
      }
    },
    "Vị Marschiato độc đáo duy nhất có tại HAHA Coffee khiến mọi khách hàng đều muốn ghé mua thêm lần nữa." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The unique Marschiato flavor, available only at HAHA Coffee, keeps our customers coming back for more."
